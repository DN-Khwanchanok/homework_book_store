<% admin_section = controller.controller_path %>

<header class="books-page admin-navigation">
  <%= link_to "← Back to books", books_path, class: "admin-back" %>

  <nav class="admin-nav" aria-label="เมนูผู้ดูแล">
    <%= link_to "จัดการหนังสือ", admin_path, class: "admin-nav-link",
        aria: { current: ("location" if ["admin", "admin/books"].include?(admin_section)) } %>
    <%= link_to "จัดการหมวดหมู่", admin_categories_path, class: "admin-nav-link",
        aria: { current: ("location" if admin_section == "admin/categories") } %>
    <%= link_to "จัดการ Market", admin_markets_path, class: "admin-nav-link",
        aria: { current: ("location" if admin_section == "admin/markets") } %>
    <%= link_to "สร้างผู้ใช้", new_admin_user_path, class: "admin-nav-link",
        aria: { current: ("location" if admin_section == "admin/users") } %>
  </nav>
</header>
